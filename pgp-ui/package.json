{
  "name": "@midnight-ntwrk/pgp-ui",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && (cp -r ../contract/src/managed/pgp/keys ./out/keys 2>/dev/null || true) && (cp -r ../contract/src/managed/pgp/zkir ./out/zkir 2>/dev/null || true)",
    "build:preview": "NEXT_PUBLIC_NETWORK_ID=preview next build && (cp -r ../contract/src/managed/pgp/keys ./out/keys 2>/dev/null || true) && (cp -r ../contract/src/managed/pgp/zkir ./out/zkir 2>/dev/null || true)",
    "build:preprod": "NEXT_PUBLIC_NETWORK_ID=preprod next build && (cp -r ../contract/src/managed/pgp/keys ./out/keys 2>/dev/null || true) && (cp -r ../contract/src/managed/pgp/zkir ./out/zkir 2>/dev/null || true)",
    "start": "next start",
    "start:static": "http-server --port 0 ./out",
    "build:start": "npm run build && npm run start:static",
    "build:start:preview": "npm run build:preview && npm run start:static",
    "build:start:preprod": "npm run build:preprod && npm run start:static",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"

  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^15.3.4",
    "node-stdlib-browser": "^1.3.1",
    "pino": "^9.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  }
}
