// VeilDraw — Private Giveaway Platform (PGP) Smart Contract
// Built for the Midnight network.
//
// One contract instance hosts one giveaway with the lifecycle:
//
//   REGISTRATION_OPEN ──> DRAW_PENDING ──> COMPLETED
//          │                    │
//          └───────> CANCELLED <┘   (organizer only, never after completion)
//
// Privacy model:
//   * Participants enter by publishing only an opaque 32-byte commitment.
//     Commitments are chained into `entryAccumulator` with a domain-separated
//     persistent hash, so the ledger never learns who entered or how entries
//     map to wallets.
//   * The organizer draws off-chain and publishes only the winning
//     commitment hash (`closeAndSelectWinner`).
//   * The winner claims by proving knowledge of a ticket secret whose
//     domain-separated hash equals the winning commitment (`claimPrize`).
//     Secret keys stay in private witnesses and never reach the ledger.
//   * Organizer-only actions are guarded by `organizerPk`, which is bound to
//     the organizer's private `localSecretKey` witness via `publicKey`.

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  REGISTRATION_OPEN,
  DRAW_PENDING,
  COMPLETED,
  CANCELLED
}

export ledger giveawayState: State;

export ledger title: Maybe<Opaque<"string">>;

export ledger prizeDetails: Maybe<Opaque<"string">>;

export ledger organizerPk: Bytes<32>;

export ledger entryCount: Counter;

export ledger entryAccumulator: Bytes<32>;

export ledger winningCommitment: Bytes<32>;

export ledger winnerClaimed: Boolean;

constructor() {
  giveawayState = State.REGISTRATION_OPEN;
  title = none<Opaque<"string">>();
  prizeDetails = none<Opaque<"string">>();
  organizerPk = pad(32, "");
  entryAccumulator = pad(32, "pgp:init");
  winningCommitment = pad(32, "");
  winnerClaimed = false;
}

// Organizer/participant secret key, held locally in private state.
witness localSecretKey(): Bytes<32>;

// Per-participant nonce, held locally in private state.
witness participantNonce(): Bytes<32>;

// Organizer initializes the giveaway. Binds `organizerPk` to the caller's
// secret key so that only the organizer can later draw or cancel.
export circuit createGiveaway(newTitle: Opaque<"string">, newPrize: Opaque<"string">): [] {
  assert(giveawayState == State.REGISTRATION_OPEN, "Giveaway is already initialized or closed");
  assert(title == none<Opaque<"string">>(), "Giveaway details are already set");
  organizerPk = disclose(publicKey(localSecretKey()));
  title = disclose(some<Opaque<"string">>(newTitle));
  prizeDetails = disclose(some<Opaque<"string">>(newPrize));
}

// Participant registers an entry commitment. The commitment is chained into
// the accumulator together with the current entry index so that every entry
// occupies a unique, order-bound position.
export circuit enterGiveaway(entryCommitment: Bytes<32>): [] {
  assert(giveawayState == State.REGISTRATION_OPEN, "Giveaway registration is closed");
  const currentCount = entryCount as Field as Bytes<32>;
  const computedCommitment = persistentHash<Vector<3, Bytes<32>>>([pad(32, "pgp:entry:"), currentCount, entryCommitment]);
  entryAccumulator = disclose(persistentHash<Vector<2, Bytes<32>>>([entryAccumulator, computedCommitment]));
  entryCount.increment(1);
}

// Organizer closes registration and publishes the drawn winning commitment.
export circuit closeAndSelectWinner(winnerCommitment: Bytes<32>): [] {
  assert(giveawayState == State.REGISTRATION_OPEN, "Giveaway registration must be open to draw winner");
  assert(organizerPk == publicKey(localSecretKey()), "Only the giveaway organizer can close and select winner");
  winningCommitment = disclose(winnerCommitment);
  giveawayState = State.DRAW_PENDING;
}

// Winner proves knowledge of the ticket secret matching the winning
// commitment and claims the prize exactly once.
export circuit claimPrize(ticketSecret: Bytes<32>): [] {
  assert(giveawayState == State.DRAW_PENDING, "Giveaway is not in draw pending state");
  assert(winnerClaimed == false, "Prize has already been claimed");
  const computedWinnerCommitment = persistentHash<Vector<3, Bytes<32>>>([pad(32, "pgp:claim:"), ticketSecret, localSecretKey()]);
  assert(disclose(computedWinnerCommitment) == winningCommitment, "Provided ticket secret does not match winning commitment");
  winnerClaimed = true;
  giveawayState = State.COMPLETED;
}

// Organizer cancels the giveaway at any point before the prize is claimed.
export circuit cancelGiveaway(): [] {
  assert(organizerPk == publicKey(localSecretKey()), "Only the giveaway organizer can cancel the giveaway");
  assert(giveawayState != State.COMPLETED, "Cannot cancel a completed giveaway");
  giveawayState = State.CANCELLED;
}

// Deterministic one-way derivation of a public identifier from a secret key.
export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "pgp:pk:"), sk]);
}
